generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  follows       Follow[]
  reactions     Reaction[]
  reads         Read[]
  sessions      Session[]
  corpseSegments CorpseSegment[]
  corpseAuthors  CorpseAuthor[]
  moderations   CorpseModeration[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Follow {
  userId     String
  authorSlug String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, authorSlug])
  @@map("follows")
}

model Read {
  userId      String
  contentType String
  slug        String
  progress    Float    @default(1)
  readAt      DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, contentType, slug])
  @@map("reads")
}

model Reaction {
  userId      String
  contentType String
  slug        String
  type        ReactionType
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, contentType, slug])
  @@map("reactions")
}

/// Reacciones de usuario a contenidos (relatos, artículos, etc.)
enum ReactionType {
  UP
  DOUBLE
}

enum CorpseStatus {
  active
  ended
  completed
  pending_moderation
}

model ExquisiteCorpse {
  id                  String         @id @default(cuid())
  title               String
  prompt              String?
  status              CorpseStatus   @default(active)
  maxContributors     Int            @default(10)
  currentContributorId String?
  createdAt           DateTime       @default(now())
  endedAt             DateTime?

  // Relations
  segments            CorpseSegment[]
  authors             CorpseAuthor[]
  moderation          CorpseModeration?

  @@map("exquisite_corpses")
}

model CorpseSegment {
  id        String          @id @default(cuid())
  corpseId  String
  authorId  String
  content   String
  wordCount Int
  position  Int
  createdAt DateTime        @default(now())
  isSkipped Boolean         @default(false)

  // Relations
  corpse    ExquisiteCorpse @relation(fields: [corpseId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([corpseId])
  @@index([authorId])
  @@index([position])
  @@map("corpse_segments")
}

model CorpseAuthor {
  id             String          @id @default(cuid())
  corpseId       String
  userId         String
  joinedAt       DateTime       @default(now())
  hasContributed Boolean        @default(false)
  voteToEnd      Boolean        @default(false)

  // Relations
  corpse         ExquisiteCorpse @relation(fields: [corpseId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([corpseId, userId])
  @@index([corpseId])
  @@index([userId])
  @@map("corpse_authors")
}

enum ModerationDecision {
  approved
  rejected
}

model CorpseModeration {
  id            String             @id @default(cuid())
  corpseId      String             @unique
  moderatorId   String
  decision      ModerationDecision
  feedback      String?
  reason        String?            // e.g., "quality", "appropriateness", "incomplete"
  reviewedAt    DateTime           @default(now())
  transtextosId String?            // ID of created Transtextos post

  // Relations
  corpse        ExquisiteCorpse    @relation(fields: [corpseId], references: [id], onDelete: Cascade)
  moderator     User               @relation(fields: [moderatorId], references: [id])

  @@index([corpseId])
  @@index([moderatorId])
  @@index([decision])
  @@map("corpse_moderations")
}
